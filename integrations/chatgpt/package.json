{
  "name": "@dominusnode/chatgpt",
  "version": "2.2.0",
  "description": "DominusNode for ChatGPT: Custom GPT Actions schema for the /v1 agent API plus an OpenAI function-calling handler for the 19 standard v2 tools, built on @dominusnode/sdk",
  "main": "dist/handler.js",
  "types": "dist/handler.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/handler.d.ts",
      "import": "./dist/handler.js"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xcircuitbreaker/DomiNode.git",
    "directory": "integrations/chatgpt"
  },
  "homepage": "https://github.com/0xcircuitbreaker/DomiNode/tree/master/integrations/chatgpt#readme",
  "bugs": {
    "url": "https://github.com/0xcircuitbreaker/DomiNode/issues"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "gen:functions": "node scripts/gen-functions.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@dominusnode/sdk": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.0",
    "yaml": "^2.8.0"
  },
  "keywords": [
    "chatgpt",
    "custom-gpt",
    "actions",
    "function-calling",
    "dominusnode",
    "relay",
    "ai-agent"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/",
    "functions.json",
    "openapi.yaml",
    "ai-plugin.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!dist/**/*.map"
  ]
}
