{
  "name": "@dominusnode/pi-extension",
  "version": "2.2.0",
  "description": "DominusNode pi extension: 19 standard v2 tools for the AI-agent relay network, built on @dominusnode/sdk",
  "keywords": [
    "pi-package",
    "dominusnode",
    "relay",
    "proxy",
    "ai-agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xcircuitbreaker/DomiNode.git",
    "directory": "integrations/pi"
  },
  "homepage": "https://github.com/0xcircuitbreaker/DomiNode/tree/master/integrations/pi#readme",
  "bugs": {
    "url": "https://github.com/0xcircuitbreaker/DomiNode/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "skills/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@dominusnode/sdk": "^2.2.0"
  },
  "peerDependencies": {
    "typebox": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typebox": "^1.4.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
