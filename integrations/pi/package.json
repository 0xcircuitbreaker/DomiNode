  "description": "Dominus Node pi-mono extension — 26 tools for rotating proxy, wallet, agentic wallets, teams, and payments",
  "keywords": [
    "pi-package",
    "dominusnode",
    "proxy",
    "ai-agent",
    "rotating-proxy"
  ],
  "license": "MIT",
  "main": "dist/index.js",
