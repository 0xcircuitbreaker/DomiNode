{
  "name": "@dominusnode/ai-tools",
  "version": "2.0.1",
  "description": "Vercel AI SDK tools for the DominusNode AI-agent relay network (19 standard v2 tools, built on @dominusnode/sdk)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xcircuitbreaker/DomiNode.git",
    "directory": "integrations/vercel-ai"
  },
  "homepage": "https://github.com/0xcircuitbreaker/DomiNode/tree/master/integrations/vercel-ai#readme",
  "bugs": {
    "url": "https://github.com/0xcircuitbreaker/DomiNode/issues"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@dominusnode/sdk": "^2.0.0"
  },
  "peerDependencies": {
    "ai": ">=5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ai": "^7.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.0"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "!dist/**/*.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "vercel-ai",
    "ai-sdk",
    "dominusnode",
    "relay",
    "proxy",
    "ai-agent",
    "x402"
