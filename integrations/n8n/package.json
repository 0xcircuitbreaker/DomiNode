{
  "name": "n8n-nodes-dominusnode",
  "version": "2.0.0",
  "description": "n8n community node for the DominusNode AI-agent relay network (19 standard v2 operations, built on @dominusnode/sdk)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/DominusNodeApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/DominusNode/DominusNode.node.js"
    ]
  },
  "scripts": {
    "build": "tsc && cp src/nodes/DominusNode/dominusnode.svg dist/nodes/DominusNode/",
    "prepare": "npm run build",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "n8n",
    "n8n-community-node-package",
    "dominusnode",
    "relay",
    "proxy",
    "ai-agent",
    "web-scraping"
  ],
  "license": "MIT",
  "dependencies": {
    "@dominusnode/sdk": "^2.0.0"
  },
  "peerDependencies": {
    "n8n-workflow": ">=1.0.0"
  },
  "devDependencies": {
    "n8n-workflow": "^2.16.0",
    "vitest": "^3.2.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
