{
  "name": "@dominusnode/openclaw-plugin",
  "version": "2.0.0",
  "description": "OpenClaw plugin for the DominusNode AI-agent relay network (19 standard v2 tools, built on @dominusnode/sdk)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@dominusnode/sdk": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.0"
  },
  "keywords": [
    "openclaw",
    "dominusnode",
    "relay",
    "proxy",
    "ai-agent",
    "x402"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Dominus-Node/dominusnode-openclaw"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/",
    "openclaw.plugin.json",
    "SKILL.md",
    "README.md",
    "CHANGELOG.md"
  ]
}
