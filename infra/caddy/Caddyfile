# Replace this hostname if you prefer a different API subdomain.
# Caddy will automatically provision/renew TLS certificates via Let's Encrypt.

api.dominusnode.com, api.dominusnode.daedalusdevelopmentgroup.com {
  encode zstd gzip

  # TLS 1.3 only. Do NOT set `curves`: Caddy >= 2.10 (Go >= 1.24) offers the
  # hybrid post-quantum group X25519MLKEM768 by default, and pinning a curve
  # list would drop it (SECURITY_ARCHITECTURE.md §2.1).
  tls {
    protocols tls1.3
  }

  # Security headers (parity with nginx config)
  header {
    X-Frame-Options "DENY"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
    Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; font-src 'self'; frame-src https://checkout.stripe.com https://nowpayments.io; form-action 'self'; base-uri 'self'; upgrade-insecure-requests;"
    -Server
    -X-Powered-By
  }

  reverse_proxy api:3000 {
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto {scheme}
    # Override upstream Helmet headers to enforce DENY
    header_down X-Frame-Options "DENY"
    header_down X-Content-Type-Options "nosniff"
    header_down -Server
    header_down -X-Powered-By
  }
}
