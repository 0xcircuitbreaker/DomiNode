{
  "name": "@dominusnode/sdk",
  "version": "2.3.0",
  "description": "Official DominusNode SDK for Node.js/TypeScript: AI-agent relay network (proxy, nodes, credits, payouts). Zero dependencies.",
  "author": "Dominus Node",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xcircuitbreaker/DomiNode.git",
    "directory": "sdks/node"
  },
  "homepage": "https://github.com/0xcircuitbreaker/DomiNode/tree/master/sdks/node#readme",
  "bugs": {
    "url": "https://github.com/0xcircuitbreaker/DomiNode/issues"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.0"
  },
  "keywords": [
    "dominusnode",
    "proxy",
    "relay",
    "ai-agent",
    "mcp",
    "x402"
  ]
}
