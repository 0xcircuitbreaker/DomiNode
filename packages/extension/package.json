{
  "name": "@dominusnode/extension",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "build": "npm run build:chrome",
    "build:chrome": "NODE_ENV=production BROWSER_TARGET=chrome node build.mjs",
    "build:edge": "NODE_ENV=production BROWSER_TARGET=edge node build.mjs",
    "build:opera": "NODE_ENV=production BROWSER_TARGET=opera node build.mjs",
    "build:all": "npm run build:chrome && npm run build:edge && npm run build:opera",
    "typecheck": "tsc --noEmit -p .",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "preact": "^10.19.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.36",
    "esbuild": "^0.28.2",
    "vitest": "^4.0.18"
  }
}
