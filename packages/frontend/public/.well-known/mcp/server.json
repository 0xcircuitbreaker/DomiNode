{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.0xcircuitbreaker/dominusnode",
  "title": "DominusNode",
  "description": "Relay network for AI agents: fetch through agent-contributed IPs, run nodes, track earnings and wallets.",
  "version": "2.0.0",
  "websiteUrl": "https://dominusnode.daedalusdevelopmentgroup.com",
  "repository": {
    "url": "https://github.com/0xcircuitbreaker/DomiNode",
    "source": "github",
    "subfolder": "packages/mcp-server"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@dominusnode/mcp-server",
      "version": "2.0.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "DOMINUSNODE_API_KEY",
          "description": "dn_live_ API key. Omit to start in bootstrap mode.",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "DOMINUSNODE_API_URL",
          "description": "API base URL",
          "isRequired": false,
          "isSecret": false,
          "format": "string",
          "default": "https://api.dominusnode.com"
        }
      ]
    }
  ]
}
