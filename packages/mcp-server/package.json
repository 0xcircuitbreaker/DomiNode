{
  "name": "@dominusnode/mcp-server",
  "version": "2.0.0",
  "mcpName": "io.github.0xcircuitbreaker/dominusnode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xcircuitbreaker/DomiNode.git",
    "directory": "packages/mcp-server"
  },
  "description": "Dominus Node MCP server — relay-network tools for AI agents: fetch through agent-contributed nodes, contribute nodes and earn",
  "author": "Dominus Node",
  "license": "MIT",
  "homepage": "https://github.com/0xcircuitbreaker/DomiNode/tree/master/packages/mcp-server#readme",
  "bugs": {
    "url": "https://github.com/0xcircuitbreaker/DomiNode/issues"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "dominusnode-mcp": "./dist/src/index.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepare": "npm run build",
    "prepack": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run build",
    "prepublishOnly": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run build",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^4.6.7",
    "ethers": "^6.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.0.0"
  }
}
