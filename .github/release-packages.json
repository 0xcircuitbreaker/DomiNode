{
  "$comment": "Publishable packages. Read by scripts/release/plan.mjs; see docs/RELEASING.md. packages/node-agent is private and not published.",
  "packages": [
    {
      "id": "sdk-node",
      "path": "sdks/node",
      "ecosystem": "npm",
      "name": "@dominusnode/sdk",
      "version": {
        "file": "package.json",
        "kind": "package-json"
      },
      "install": "npm ci",
      "build": "npm run build",
      "test": "npm test",
      "dependsOn": []
    },
    {
      "id": "sdk-python",
      "path": "sdks/python",
      "ecosystem": "pypi",
      "name": "dominusnode",
      "version": {
        "file": "pyproject.toml",
        "kind": "pyproject"
      },
      "install": "pip install -e \".[dev]\"",
      "build": "python -m build",
      "test": "python -m pytest -q",
      "dependsOn": []
    },
    {
      "id": "sdk-go",
      "path": "sdks/go",
      "ecosystem": "go",
      "name": "github.com/0xcircuitbreaker/DomiNode/sdks/go/v2",
      "version": {
        "file": "client.go",
        "kind": "go-const",
        "const": "SDKVersion"
      },
      "install": "go mod download",
      "build": "go build ./...",
      "test": "go vet ./... && go test ./...",
      "dependsOn": []
    },
    {
      "id": "sdk-rust",
      "path": "sdks/rust",
      "ecosystem": "crates",
      "name": "dominusnode",
      "version": {
        "file": "Cargo.toml",
        "kind": "cargo"
      },
      "install": "cargo fetch",
      "build": "cargo build --all-features",
      "test": "cargo test --all-features",
      "dependsOn": []
    },
    {
      "id": "sdk-java",
      "path": "sdks/java",
      "ecosystem": "maven",
      "name": "io.dominusnode:dominusnode-sdk",
      "version": {
        "file": "pom.xml",
        "kind": "pom"
      },
      "install": "mvn -B -q dependency:go-offline",
      "build": "mvn -B -DskipTests package",
      "test": "mvn -B verify",
      "dependsOn": []
    },
    {
      "id": "sdk-cpp",
      "path": "sdks/cpp",
      "ecosystem": "cpp-release",
      "name": "dominusnode-cpp",
      "version": {
        "file": "CMakeLists.txt",
        "kind": "cmake"
      },
      "install": "sudo apt-get update && sudo apt-get install -y libcurl4-openssl-dev nlohmann-json3-dev",
      "build": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build --parallel",
      "test": "ctest --test-dir build --output-on-failure",
      "dependsOn": []
    },
    {
      "id": "mcp-server",
      "path": "packages/mcp-server",
      "ecosystem": "npm",
      "name": "@dominusnode/mcp-server",
      "version": {
        "file": "package.json",
        "kind": "package-json"
      },
      "install": "cd ../.. && npm ci",
      "build": "cd ../.. && npm run build",
      "test": "cd ../.. && npx vitest run packages/mcp-server",
      "dependsOn": []
    },
    {
