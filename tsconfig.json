{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist"
  },
  "references": [
    { "path": "packages/shared" },
    { "path": "packages/proxy-gateway" },
    { "path": "packages/pool-manager" },
    { "path": "packages/metering" },
    { "path": "packages/billing" },
    { "path": "packages/dashboard" },
    { "path": "packages/mcp-server" },
    { "path": "packages/node-agent" }
  ],
  "files": []
}
