# SECURITY: Never commit this file with real values. Copy to .env and fill in your secrets.

# ─── Environment ───────────────────────────────────────────────
NODE_ENV=development

# ─── PostgreSQL (Docker) ──────────────────────────────────────
# These are used by docker-compose to create the DB and build DATABASE_URL.
POSTGRES_DB=dominusnode
POSTGRES_USER=dominusnode
# REQUIRED: Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Database (for local/non-Docker use — docker-compose builds this automatically)
DATABASE_URL=postgresql://dominusnode:dominusnode_dev@localhost:5432/dominusnode
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_CONNECTION_TIMEOUT_MS=5000

# Proxy Gateway
PROXY_LISTEN_PORT=8080

# Dashboard API
DASHBOARD_PORT=3000

# Auth
# REQUIRED: Generate with: openssl rand -hex 32
JWT_SECRET=

# MFA (2FA/TOTP)
# Generate: openssl rand -hex 32
MFA_ENCRYPTION_KEY=

# ─── Admin-only fiat rails ─────────────────────────────────────
# Stripe and PayPal are used only by human admins (manual credits/refunds).
# Agents pay via x402, MPP, Tempo or NOWPayments crypto. Leave blank to disable.
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/dashboard?topup=success
STRIPE_CANCEL_URL=http://localhost:3000/dashboard?topup=cancel
# Comma-separated payment methods for Stripe Checkout (card is always included)
# PayPal must be enabled in Stripe Dashboard: Settings > Payment Methods > PayPal
# Stripe Link is auto-enabled for eligible accounts
# Options: card,link,paypal (default: card,link)
STRIPE_PAYMENT_METHODS=card,link
# Required Stripe webhook events: checkout.session.completed,
#   checkout.session.async_payment_succeeded, checkout.session.async_payment_failed

# NOWPayments (crypto: BTC, ETH, LTC, XMR, ZEC, USDC, SOL, USDT, DAI, BNB, LINK)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1

# PayPal (admin-only)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_RETURN_URL=http://localhost:5173/wallet?topup=success&provider=paypal
PAYPAL_CANCEL_URL=http://localhost:5173/wallet?topup=cancel&provider=paypal
# Required webhook events: CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED

# SOCKS5 Proxy
SOCKS5_LISTEN_PORT=1080

# ─── Docker Port Bindings ──────────────────────────────────────
# Controls how container ports are exposed on the host.
# Use 127.0.0.1:PORT for localhost-only, 0.0.0.0:PORT for public.
PROXY_HTTP_HOST_PORT=127.0.0.1:8080
PROXY_SOCKS5_HOST_PORT=127.0.0.1:1080
FRONTEND_HOST_PORT=127.0.0.1:80
# Caddy (VPS overlay — docker-compose.vps.yml)
# API_HTTP_HOST_PORT=80
# API_HTTPS_HOST_PORT=443

# Proxy Tunables
PROXY_CONNECT_TIMEOUT_MS=30000
PROXY_SESSION_MAX_AGE_MS=3600000
PROXY_STALE_CLEANUP_INTERVAL_MS=60000
BALANCE_CACHE_TTL_MS=5000
PROXY_MAX_RETRIES=2
PROXY_RETRY_BASE_DELAY_MS=200
PROXY_MAX_CONNECTIONS=5000
PROXY_PUBLIC_HOST=proxy.dominusnode.daedalusdevelopmentgroup.com

# Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_MS=30000

# ─── Relay network (see docs/agent-network/DEPLOYMENT.md) ─────
# Node agents dial wss://<host>/v1/tunnel on TUNNEL_PORT.
# TUNNEL_PORT=8443
# TUNNEL_TLS_CERT_FILE=
# TUNNEL_TLS_KEY_FILE=
# TUNNEL_TRUSTED_PROXY_IPS=
# Coordinator ed25519 signing key (npm run gen:coord-key). Required in production.
# COORD_SIGNING_KEY_FILE=/run/secrets/coord-signing.pem
# Federation documents (/.well-known/dominusnode/coordinator.json and policy.json,
# docs/agent-network/FEDERATION.md). Served by the API, signed with
# COORD_SIGNING_KEY_FILE. APP_URL must be https:// or the documents return 503.
# Domains are config only: list every host this coordinator answers on.
# COORDINATOR_HOSTNAMES=example.org,relay.example.net   (default: DOMINUSNODE_DOMAIN, else APP_URL host)
# COORD_TUNNEL_URL=wss://relay.example.org/v1/tunnel   (default: wss://relay.<first hostname>/v1/tunnel)
# PROXY_PUBLIC_HOST=proxy.example.org                 (default: proxy.<first hostname>)
# Rotation keys advertised alongside the signer (hex, comma-separated; an invalid entry makes the documents return 503).
# Node agents trust them only after their fingerprints are confirmed with --trust.
# COORD_ADDITIONAL_PUBKEYS=
# Keys that get the official network branding/contact defaults (hex, comma-separated).
# OFFICIAL_COORD_PUBKEYS=
# Branding and contacts (forks: set your own; reserved official names are replaced).
# SITE_NAME=
# OPERATOR_NAME=
# OPERATOR_CONTACT=mailto:ops@example.org
# ABUSE_CONTACT=mailto:abuse@example.org
# ASN + country database (scripts/update-asn-db.sh). Drives OFAC geo checks,
# node peer geo and dc/residential classification. Missing = public traffic refused.
# ASN_DB_FILE=
# HOSTING_ASNS=

# ─── Agent payment rails ───────────────────────────────────────
# RELAY_RAILS=x402,mpp,tempo
# X402_ENABLED=false
# X402_RECEIVING_ADDRESS=
# MPP_CHALLENGE_SECRET=     # >= 32 chars
# MPP_PAY_TO=
# MPP_CURRENCY=
# MPP_CHAIN_ID=
# MPP_RPC_URL=
# TEMPO_WEBHOOK_SECRET=
# TEMPO_PAY_TO=
# TEMPO_CHAIN_ID=

# Proxy Config (for browser extension proxy endpoint info)
PROXY_HOST=localhost
PROXY_HTTP_PORT=8080
PROXY_SOCKS5_PORT=1080

# Internal proxy hostname (used by API container to reach proxy container)
# In Docker: "proxy" (service name). Bare-metal: "127.0.0.1"
# PROXY_INTERNAL_HOST=proxy
# PROXY_INTERNAL_PORT=8080

# Auth Rate Limiting
# AUTH_FAIL_MAX=5
# AUTH_FAIL_WINDOW_MS=60000

# Per-user Connection Limit
# PROXY_MAX_PER_USER=100

# Session Rate Limiting
# MAX_SESSIONS_PER_MINUTE=30

# Webhook IP Allowlisting (optional — comma-separated IPs)
# STRIPE_WEBHOOK_IPS=
# NOWPAYMENTS_WEBHOOK_IPS=
# PAYPAL_WEBHOOK_IPS=

# CORS
CORS_ORIGINS=http://localhost:5173

# Reverse Proxy Trust
# Set to number of proxy hops (1 for single Caddy/nginx, 2 for Cloudflare+nginx)
# Required for correct client IP in rate limiting, lockout, and webhook IP checks
# TRUST_PROXY=1
# Force secure (HTTPS-only) cookies (default: true in production behind TLS proxy)
# COOKIE_SECURE=true

# Wallet Auth (EVM wallet-based authentication)
DOMINUSNODE_DOMAIN=dominusnode.daedalusdevelopmentgroup.com

# Registration Cap (Alpha: 2500, Beta: 10000, 0 = unlimited for production)
# Set to 0 for production (unlimited registrations)
MAX_REGISTERED_USERS=0

# Email (SMTP — for password reset + email verification)
# Set EMAIL_ENABLED=true to send real emails. When false, emails are logged to console.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=0xcircuitbreaker@protonmail.com
SMTP_SECURE=false
SMTP_IGNORE_TLS=true
# Reject unauthorized TLS certs (set false for self-signed certs like local Postfix)
# SMTP_REJECT_UNAUTHORIZED=true
APP_URL=http://localhost:5173

# reCAPTCHA (anti-bot on registration — get keys from https://www.google.com/recaptcha)
# NEVER commit real keys here — these must be set via environment only
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Score threshold (0.0 = bot, 1.0 = human). Default: 0.5
# RECAPTCHA_SCORE_THRESHOLD=0.5

# MCP agent auto-verification secret (shared between MCP server and backend)
MCP_AGENT_SECRET=

# Agent rate-limit multiplier (for MCP agent swarms)
# Verified MCP agents get this multiplier on non-security rate limits.
# Default: 10 (range: 1-100)
AGENT_RATE_LIMIT_MULTIPLIER=10

# x402 Protocol (pay-per-request micropayments for AI agents)
# Master switch — must be explicitly enabled
X402_ENABLED=false

# ── Coinbase x402 (Base chain — USDC, EIP-3009 gasless) ─────────────
# EVM 0x address on Base to receive USDC payments via Coinbase facilitator
X402_RECEIVING_ADDRESS=
# Network: "base" (mainnet) or "base-sepolia" (testnet)
# X402_NETWORK=base-sepolia

# ── PayAI x402 — Solana (USDC SPL, ~400ms settlement) ───────────────
X402_RECEIVING_ADDRESS_SOLANA=

# ── PayAI x402 — EVM chains (all use 0x USDC addresses) ─────────────
# Set any subset of these to accept payments on those chains.
# All EVM chains route through the PayAI facilitator (https://api.payai.network).
# Polygon and Avalanche have well-known Circle USDC addresses (auto-configured).
# Sei, SKALE, IoTeX, XLayer, and Peaq use bridged USDC — set the corresponding
# X402_USDC_ADDRESS_{CHAIN} var with the bridged USDC contract address on that network.
X402_RECEIVING_ADDRESS_POLYGON=
X402_RECEIVING_ADDRESS_AVALANCHE=
X402_RECEIVING_ADDRESS_SEI=
X402_RECEIVING_ADDRESS_SKALE=
X402_RECEIVING_ADDRESS_IOTEX=
X402_RECEIVING_ADDRESS_XLAYER=
X402_RECEIVING_ADDRESS_PEAQ=

# Bridged USDC contract addresses for exotic PayAI chains (required if using those chains).
# Sei: axlUSDC or canonical bridged USDC contract on Sei EVM
# X402_USDC_ADDRESS_SEI=
# SKALE Base Hub: bridged USDC via Meson/other bridge on skale-base chain
# X402_USDC_ADDRESS_SKALE_BASE=
# IoTeX: bridged USDC via ioTube bridge (e.g. 0xcdf79194c6c285077a58da47641d4dbe51f63542)
# X402_USDC_ADDRESS_IOTEX=
# XLayer (OKX L2): bridged USDC on XLayer network
# X402_USDC_ADDRESS_XLAYER=
# Peaq: bridged USDC on Peaq EVM parachain
# X402_USDC_ADDRESS_PEAQ=

# Per-request pricing (in USD, applied uniformly across all chains)
X402_DC_PRICE_PER_REQUEST_USD=0.001
X402_RES_PRICE_PER_REQUEST_USD=0.005
# Max response size per paid x402 request (default 10MB).
# This bounds the max value extracted per flat-rate payment.
# Increase when upto/streaming x402 schemes are available.
X402_MAX_REQUEST_BODY_BYTES=10485760

# Coinbase Developer Platform (for Coinbase x402 facilitator)
# Get from: https://portal.cdp.coinbase.com/ → API Keys
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# PayAI (for PayAI x402 facilitator)
# Get from: https://payai.network → Dashboard → API Keys
PAYAI_API_KEY_ID=
PAYAI_API_KEY_SECRET=

# ─── Admin ──────────────────────────────────────────────────────
# Comma-separated emails allowed to grant credits via admin API
# ADMIN_CREDIT_EMAILS=0xcircuitbreaker@protonmail.com
# Max credit amount in cents that can be granted at once (default: 50000 = $500)
# ADMIN_MAX_CREDIT_CENTS=50000

# ─── AI Agent Rate Limits ──────────────────────────────────────
# Multiplier for rate limits on AI agent traffic (x402 payers + agentic wallet users)
# Applied to x402 rate limits and session rate limits for agent-identified requests
# Default: 10 (agents get 10x the base limit). Range: 1-100.
AGENT_RATE_LIMIT_MULTIPLIER=10

# ─── GeoIP ──────────────────────────────────────────────────────
# Set to 1 to skip geo/OFAC checks and the ASN DB load (dev/testing only;
# ignored when NODE_ENV=production)
# SKIP_GEOIP=0

# Logging
LOG_LEVEL=info

# Frontend (Vite env vars — set in packages/frontend/.env or at build time)
# VITE_ALPHA_MODE=false    # Set to "false" for production builds to hide ALPHA pill
# VITE_RECAPTCHA_SITE_KEY= # Same as RECAPTCHA_SITE_KEY — passed to frontend at build time

# Tempo prepaid top-up (all four required together; see docs/agent-network/PAYMENTS.md)
# TEMPO_WEBHOOK_SECRET=     # HMAC secret shared with the chain watcher
# TEMPO_PAY_TO=             # 0x receiving address
# TEMPO_TOKEN=              # 0x TIP-20 stablecoin contract
# TEMPO_CHAIN_ID=

# MPP per-request rail (disabled unless all required values are set)
# MPP_CHALLENGE_SECRET=     # HMAC key for challenge ids
# MPP_PAY_TO=
# MPP_CURRENCY=             # token contract
# MPP_CHAIN_ID=
# MPP_RPC_URL=              # https only
# MPP_REALM=                # optional
