# SECURITY: Never commit this file with real values. Copy to .env and fill in your secrets.

# Database
DATABASE_URL=postgresql://dominusnode:dominusnode_dev@localhost:5432/dominusnode
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_CONNECTION_TIMEOUT_MS=5000

# Proxy Gateway
PROXY_LISTEN_PORT=8080

# Dashboard API
DASHBOARD_PORT=3000

# Auth
# REQUIRED: Generate with: openssl rand -hex 32
JWT_SECRET=

# MFA (2FA/TOTP)
# Generate: openssl rand -hex 32
MFA_ENCRYPTION_KEY=

# Webshare Proxy
WEBSHARE_PROXY_HOST=p.webshare.io
WEBSHARE_HTTP_PORT=80
WEBSHARE_SOCKS5_PORT=1080

# Webshare Datacenter Pool — TWO MODES (choose one):
#
# Mode A: Gateway (rotating DC via p.webshare.io)
#   Requires a "Rotating Datacenter" Webshare plan.
#   Set WEBSHARE_DC_USERNAME and WEBSHARE_DC_PASSWORD.
#
# Mode B: Static Proxy List (round-robin through individual DC IPs)
#   Requires a "Proxy Servers" (static) Webshare plan + API key.
#   Leave DC_USERNAME/DC_PASSWORD empty, set WEBSHARE_API_KEY below.
#   The system auto-fetches your proxy list from the Webshare API.
#
# WEBSHARE_DC_USERNAME=
# WEBSHARE_DC_PASSWORD=

# Webshare Residential Pool (~$40/mo, 80M+ IPs, 10GB included)
WEBSHARE_RES_USERNAME=
WEBSHARE_RES_PASSWORD=

# Webshare API Key (required for DC static mode + bandwidth monitoring)
WEBSHARE_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/dashboard?topup=success
STRIPE_CANCEL_URL=http://localhost:3000/dashboard?topup=cancel
# Comma-separated payment methods for Stripe Checkout (card is always included)
# PayPal must be enabled in Stripe Dashboard: Settings > Payment Methods > PayPal
# Stripe Link is auto-enabled for eligible accounts
# Options: card,link,paypal (default: card,link)
STRIPE_PAYMENT_METHODS=card,link
# Required Stripe webhook events: checkout.session.completed,
#   checkout.session.async_payment_succeeded, checkout.session.async_payment_failed

# NOWPayments (crypto: BTC, ETH, LTC, XMR, ZEC, USDC, SOL, USDT, DAI, BNB, LINK)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1

# SOCKS5 Proxy
SOCKS5_LISTEN_PORT=1080

# Proxy Tunables
PROXY_CONNECT_TIMEOUT_MS=30000
PROXY_SESSION_MAX_AGE_MS=3600000
PROXY_STALE_CLEANUP_INTERVAL_MS=60000
BALANCE_CACHE_TTL_MS=5000
PROXY_MAX_RETRIES=2
PROXY_RETRY_BASE_DELAY_MS=200
PROXY_MAX_CONNECTIONS=5000
PROXY_PUBLIC_HOST=proxy.dominusnode.com

# Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_MS=30000

# Multi-Provider Failover (optional — add fallback proxies for resilience)
# Supports up to 10 fallback providers. Gaps are allowed (e.g. _1_ and _3_ without _2_).
# FALLBACK_PROXY_1_HOST=oracle-vm.example.com
# FALLBACK_PROXY_1_PORT=8080
# FALLBACK_PROXY_1_USER=proxyuser
# FALLBACK_PROXY_1_PASS=proxypass
# FALLBACK_PROXY_2_HOST=gcp-vm.example.com
# FALLBACK_PROXY_2_PORT=3128

# Proxy Config (for browser extension proxy endpoint info)
PROXY_HOST=localhost
PROXY_HTTP_PORT=8080
PROXY_SOCKS5_PORT=1080

# Auth Rate Limiting
# AUTH_FAIL_MAX=5
# AUTH_FAIL_WINDOW_MS=60000

# Per-user Connection Limit
# PROXY_MAX_PER_USER=100

# Session Rate Limiting
# MAX_SESSIONS_PER_MINUTE=30

# Webhook IP Allowlisting (optional — comma-separated IPs)
# STRIPE_WEBHOOK_IPS=
# NOWPAYMENTS_WEBHOOK_IPS=

# CORS
CORS_ORIGINS=http://localhost:5173

# Reverse Proxy Trust (R13 C-2)
# Set to number of proxy hops (1 for single nginx, 2 for Cloudflare+nginx)
# Required for correct client IP in rate limiting, lockout, and webhook IP checks
# TRUST_PROXY=1

# Wallet Auth (EVM wallet-based authentication)
DOMINUSNODE_DOMAIN=dominusnode.com

# Registration Cap (Alpha: 250, Beta: 1000, 0 = unlimited for production)
# Set to 0 for production (unlimited registrations)
MAX_REGISTERED_USERS=0

# Email (SMTP — for password reset + email verification)
# Set EMAIL_ENABLED=true to send real emails. When false, emails are logged to console.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@dominusnode.com
SMTP_SECURE=false
SMTP_IGNORE_TLS=true
APP_URL=http://localhost:5173

# reCAPTCHA (anti-bot on registration — get keys from https://www.google.com/recaptcha)
# R36 C-10: NEVER commit real keys here — these must be set via environment only
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# MCP agent auto-verification secret (shared between MCP server and backend)
MCP_AGENT_SECRET=

# Logging
LOG_LEVEL=info

# Frontend (Vite env vars — set in packages/frontend/.env or at build time)
# VITE_ALPHA_MODE=false    # Set to "false" for production builds to hide ALPHA pill
# VITE_RECAPTCHA_SITE_KEY= # Same as RECAPTCHA_SITE_KEY — passed to frontend at build time
