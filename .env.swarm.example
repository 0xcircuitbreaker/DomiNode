# ============================================================================
# Dominus Node Swarm Configuration
# Copy to .env.swarm and fill in required values
# Usage: ./scripts/swarm.sh <num_agents> [team|solo|both]
# ============================================================================

# ─── Required ────────────────────────────────────────────────────────
ADMIN_EMAIL=CHANGE_ME@example.invalid
ADMIN_PASSWORD=
# MCP agent secret (bypasses CAPTCHA for AI agent registration/login)
DOMINUSNODE_AGENT_SECRET=

# ─── Credits ─────────────────────────────────────────────────────────
SWARM_TEAM_CREDIT=10000
SWARM_AGENT_CREDIT=500
SWARM_AGENT_PLAN=swarm-mixed

# ─── Agent Behavior ──────────────────────────────────────────────────
SWARM_PASSWORD=
SWARM_BATCH_SIZE=25
SWARM_BATCH_DELAY=10
SWARM_CYCLES=5
SWARM_DELAY_SEC=5
SWARM_RES_SCRAPES=1
SWARM_DC_REQUESTS=4

# ─── Posting (optional) ──────────────────────────────────────────────
SWARM_POST_URLS=
SWARM_POST_TOKENS=

# ─── Logging ─────────────────────────────────────────────────────────
SWARM_LOG_DIR=/tmp/dominusnode-swarm

# ─── Server ──────────────────────────────────────────────────────────
API_BASE=http://localhost:3000
PROXY_HOST=localhost
PROXY_PORT=8080

# ─── AI Swarm (for ./scripts/ai-swarm.sh or ai-swarm.ps1) ───────────
#
# ONE model instance on GPU serves ALL agent threads via batched inference.
#
# RTX 5090 (32GB VRAM) — recommended models (updated Mar 2026):
#   Qwen3.5-27B (~17GB Q4) — BEST QUALITY: BFCL 68.5, SWE-bench 72.4, beats GPT-5 mini
#   Qwen3.5-35B-A3B (~24GB Q4) — FAST+SMART: MoE 3B active, BFCL 67.3, ~80 tok/s
#   Qwen3.5-9B (~6.6GB Q4) — BEST VALUE: beats Qwen3-30B, 50+ agents, ~70 tok/s
#   Qwen3.5-4B (~3.4GB Q4) — MAX CONCURRENCY: 80+ agents, GPQA 76.2, ~100 tok/s
#   Qwen3-Coder-30B-A3B (~18GB Q4) — MoE 3.3B active, purpose-built for tool use
#   GLM-4.7-Flash (~18GB Q4) — MoE 3B active, strong tool-use benchmarks (Jan 2026)
#
# RTX 3060M (6GB VRAM) — recommended models (updated Mar 2026):
#   Qwen3.5-4B (~3.4GB Q4) — BEST: 262K ctx, multimodal, native tool calling
#   Qwen3.5-2B (~1.9GB Q4) — lightweight: multimodal + tool calling at 2B
#   Qwen3.5-0.8B (~1GB Q4) — ultra-light edge: max concurrency (20-30 agents)
#   Gemma 3 4B QAT (~2.6GB Q4) — Google's QAT preserves BF16 quality at int4
#
# Backend options:
#   Ollama (recommended for Windows / quick setup)
#     AI_MODEL=qwen3.5:4b             # 6GB GPU
#     AI_MODEL=qwen3.5:9b             # 32GB GPU (best value — 50+ agents)
#     AI_MODEL=qwen3.5:27b            # 32GB GPU (best quality — 5-10 agents, ~20 tok/s)
#     AI_MODEL=qwen3.5:35b-a3b        # 32GB GPU (fast+smart — 10-20 agents, ~80 tok/s)
#     AI_SKIP_SERVER=1
#     AI_API_BASE=http://localhost:11434/v1
#
#   SGLang (recommended for Linux / max throughput)
#     AI_MODEL=Qwen/Qwen3.5-4B        # 6GB GPU
#     AI_MODEL=Qwen/Qwen3.5-9B        # 32GB GPU (best value)
#     AI_MODEL=Qwen/Qwen3.5-27B       # 32GB GPU (best quality)
#     AI_MODEL=Qwen/Qwen3.5-35B-A3B   # 32GB GPU (fast+smart)
#     AI_SKIP_SERVER=0
#     AI_API_BASE=http://localhost:8000/v1

AI_MODEL=qwen3.5:9b
AI_SGLANG_PORT=8000
AI_SGLANG_TP=1
AI_SGLANG_MEM_FRAC=0.85
# Set to 1 to skip launching SGLang (use external OpenAI-compatible API like Ollama)
AI_SKIP_SERVER=1
# Override AI API URL (e.g., for Ollama, vLLM, or remote server)
AI_API_BASE=http://localhost:11434/v1
