# ============================================================================
# DomiNode Swarm Configuration
# Copy to .env.swarm and fill in required values
# Usage: ./scripts/swarm.sh <num_agents> [team|solo|both]
# ============================================================================

# ─── Required ────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=

# ─── Credits ─────────────────────────────────────────────────────────
SWARM_TEAM_CREDIT=10000
SWARM_AGENT_CREDIT=500
SWARM_AGENT_PLAN=swarm-mixed

# ─── Agent Behavior ──────────────────────────────────────────────────
SWARM_PASSWORD=
SWARM_BATCH_SIZE=25
SWARM_BATCH_DELAY=10
SWARM_CYCLES=5
SWARM_DELAY_SEC=5
SWARM_RES_SCRAPES=1
SWARM_DC_REQUESTS=4

# ─── Posting (optional) ──────────────────────────────────────────────
SWARM_POST_URLS=
SWARM_POST_TOKENS=

# ─── Logging ─────────────────────────────────────────────────────────
SWARM_LOG_DIR=/tmp/dominusnode-swarm

# ─── Server ──────────────────────────────────────────────────────────
API_BASE=http://localhost:3000
PROXY_HOST=localhost
PROXY_PORT=8080

# ─── AI Swarm (for ./scripts/ai-swarm.sh or ai-swarm.ps1) ───────────
#
# ONE model instance on GPU serves ALL agent threads via batched inference.
# VRAM budget (32GB RTX 5090):
#   Model weights:  ~5GB (Qwen3-8B Q4) or ~12GB (GLM-4-9B Q5)
#   KV cache:       ~4-8GB (scales with concurrent requests)
#   CUDA overhead:  ~2GB
#   Total:          ~18-22GB — remaining is headroom for 10-50 concurrent agents
#
# Recommended models for RTX 5090 (32GB VRAM):
#   Qwen/Qwen3-8B  (~5GB Q4)  — fast, good quality, leaves most VRAM for KV cache
#   THUDM/glm-4-9b-chat (~12GB Q5) — higher quality, less KV cache headroom
#   Qwen/Qwen3-Coder-30B-A3B (~21GB Q5) — MoE, only 3B active params, very fast
#
# Backend options:
#   Ollama (recommended for Windows) — simplest setup, auto-manages models
#     AI_MODEL=qwen3:8b
#     AI_SKIP_SERVER=1
#     AI_API_BASE=http://localhost:11434/v1
#
#   SGLang (recommended for Linux) — best batched inference, RadixAttention
#     AI_MODEL=Qwen/Qwen3-8B
#     AI_SKIP_SERVER=0
#     AI_API_BASE=http://localhost:8000/v1

AI_MODEL=THUDM/glm-4-9b-chat
AI_SGLANG_PORT=8000
AI_SGLANG_TP=1
AI_SGLANG_MEM_FRAC=0.85
# Set to 1 to skip launching SGLang (use external OpenAI-compatible API like Ollama)
AI_SKIP_SERVER=0
# Override AI API URL (e.g., for Ollama, vLLM, or remote server)
# AI_API_BASE=http://localhost:8000/v1
