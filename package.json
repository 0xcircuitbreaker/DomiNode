{
  "name": "dominusnode",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build && cp packages/shared/src/schema.sql packages/shared/dist/src/schema.sql",
    "start:proxy": "node packages/proxy-gateway/dist/src/main.js",
    "start:api": "node packages/dashboard/dist/src/main.js",
    "db:migrate": "node packages/shared/dist/src/migrate.js",
    "lint": "eslint packages/*/src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write 'packages/*/src/**/*.ts'",
    "clean": "tsc --build --clean && rm -rf packages/*/dist",
    "start:frontend": "npm run dev --workspace=packages/frontend",
    "test:frontend": "vitest run --config packages/frontend/vitest.config.ts",
    "gen:coord-key": "node scripts/gen-coord-key.mjs",
    "admin:set-root": "node scripts/set-root-admin.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^25.2.1",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}
